# Copy thành .env rồi điền giá trị thật. Không commit file .env!
# Để trống TURSO_* để dùng DB local (file ./data/wedding.db)

# Turso cloud (tạo tại https://turso.tech — xem README)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Chuỗi bí mật cho phiên đăng nhập (đổi thành chuỗi ngẫu nhiên dài)
SESSION_SECRET=doi-chuoi-nay-thanh-ngau-nhien-dai

PORT=3000
NODE_ENV=production
